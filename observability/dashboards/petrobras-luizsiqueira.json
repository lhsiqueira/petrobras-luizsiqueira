{
  "uid": "petrobras-luizsiqueira",
  "title": "petrobras-luizsiqueira | Aplicação",
  "tags": ["poc", "kubernetes"],
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Pods coletados pelo Prometheus",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 5},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"petrobras-luizsiqueira-app\"})",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "title": "Requisições na raiz nos últimos 5 minutos",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 5},
      "fieldConfig": {"defaults": {"decimals": 0}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(poc_home_requests_total{job=\"petrobras-luizsiqueira-app\"}[5m]))",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "title": "Requisições na raiz por segundo",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 5, "w": 24, "h": 9},
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(poc_home_requests_total{job=\"petrobras-luizsiqueira-app\"}[1m]))",
          "legendFormat": "Total"
        }
      ]
    }
  ]
}
